#include <furi.h>
#include <furi_hal.h>
#include <gui/gui.h>
#include <gui/view_dispatcher.h>
#include <gui/modules/text_box.h>

#define FLAME_SENSOR_PIN &gpio_ext_pa1 // Change if wired to a different pin

int32_t flame_sensor_app(void* p) {
    UNUSED(p);

    Gui* gui = furi_record_open(RECORD_GUI);
    ViewDispatcher* view_dispatcher = view_dispatcher_alloc();
    TextBox* text_box = text_box_alloc();

    view_dispatcher_attach_to_gui(view_dispatcher, gui, ViewDispatcherTypeFullscreen);
    view_dispatcher_add_view(view_dispatcher, 0, text_box_get_view(text_box));
    view_dispatcher_switch_to_view(view_dispatcher, 0);

    // Configure pin
    furi_hal_gpio_init_simple(FLAME_SENSOR_PIN, GpioModeInput);

    while (1) {
        if (furi_hal_gpio_read(FLAME_SENSOR_PIN) == false) {
            text_box_set_text(text_box, "🔥 Flame Detected!");
        } else {
            text_box_set_text(text_box, "No Flame Detected");
        }

        view_dispatcher_draw(view_dispatcher);
        furi_delay_ms(500); // Read every 0.5 seconds

        // Exit if back button is pressed
        if (view_dispatcher_get_result(view_dispatcher)) break;
    }

    // Clean up
    text_box_free(text_box);
    view_dispatcher_free(view_dispatcher);
    furi_record_close(RECORD_GUI);

    return 0;
}
